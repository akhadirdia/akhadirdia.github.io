---
import { experiences } from '../data/experience';

const badgeStyles: Record<string, string> = {
  industry: 'bg-indigo-500/15 text-indigo-400 border-indigo-500/30',
  research:  'bg-cyan-500/15  text-cyan-400  border-cyan-500/30',
  policy:    'bg-violet-500/15 text-violet-400 border-violet-500/30',
};

const badgeLabel: Record<string, string> = {
  industry: 'Industry',
  research: 'Research',
  policy:   'Policy',
};

const dotColor: Record<string, string> = {
  industry: 'bg-indigo-500',
  research:  'bg-cyan-400',
  policy:    'bg-violet-500',
};
---

<section id="experience" class="py-24 px-6 bg-slate-900/30">
  <div class="max-w-4xl mx-auto">

    <!-- Section header -->
    <div class="mb-14">
      <p class="text-indigo-400 font-mono text-sm mb-2 tracking-widest uppercase">Experience</p>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-100">Where I've worked</h2>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-6 top-2 bottom-2 w-px bg-slate-700/60"></div>

      <div class="space-y-12">
        {experiences.map((exp) => (
          <div class="relative pl-12 md:pl-16">
            <!-- Dot -->
            <div class={`absolute left-[11px] md:left-[19px] top-1.5 w-3 h-3 rounded-full border-2 border-[#0a0f1e] ${dotColor[exp.type]}`}></div>

            <!-- Card -->
            <div class="bg-slate-800/40 border border-slate-700/50 rounded-xl p-6 hover:border-slate-600/70 transition-colors duration-300">
              <!-- Header row -->
              <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div>
                  <h3 class="text-lg font-bold text-slate-100">{exp.title}</h3>
                  <p class="text-indigo-400 font-medium mt-0.5">{exp.org}</p>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                  <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${badgeStyles[exp.type]}`}>
                    {badgeLabel[exp.type]}
                  </span>
                  {exp.type === 'research' && (
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full border bg-amber-500/15 text-amber-400 border-amber-500/30">
                      Concurrent role
                    </span>
                  )}
                </div>
              </div>

              <!-- Period & location -->
              <p class="text-sm text-slate-500 font-mono mb-4">
                {exp.period} · {exp.location}
              </p>

              <!-- Bullets -->
              <ul class="space-y-2">
                {exp.bullets.map((b) => (
                  <li class="flex gap-3 text-sm text-slate-400 leading-relaxed">
                    <span class="text-indigo-500 mt-1 shrink-0">▸</span>
                    <span set:html={b} />
                  </li>
                ))}
              </ul>

              <!-- Stack chips -->
              {exp.stack && (
                <div class="mt-5 flex flex-wrap gap-2">
                  {exp.stack.map((s) => (
                    <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-700/60 text-slate-400">
                      {s}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
